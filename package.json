{
  "name": "minecraft-rcon-panel",
  "version": "1.0.0",
  "description": "Web RCON panel for multiple Minecraft servers",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "build:auth": "mkdir -p build && gcc auth_pam.c -o build/auth_pam.bin -l:libpam.so.0",
    "build:pkg": "pkg . --target node18-linux-x64 --output build/mc-rcon-panel.bin",
    "build": "npm run build:auth && npm run build:pkg"
  },
  "dependencies": {
    "express": "^4.19.2",
    "rcon-client": "^4.2.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}